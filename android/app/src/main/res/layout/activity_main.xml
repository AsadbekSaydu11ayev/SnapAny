<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090e"
    android:orientation="vertical">

    <!-- Yuqori boshqaruv paneli -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#0b0f19"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SnapAny Android"
            android:textColor="#f1f5f9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnServerSettings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1e293b"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Server"
            android:textAllCaps="false"
            android:textColor="#93c5fd"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#1e293b"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Yangilash"
            android:textAllCaps="false"
            android:textColor="#e2e8f0"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="#6366f1"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#07090e" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Xatolik ekrani -->
        <LinearLayout
            android:id="@+id/errorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#07090e"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Serverga ulanib bo'lmadi"
                android:textColor="#f87171"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Server ishga tushirilganini va telefon hamda kompyuter bitta Wi-Fi tarmog'ida ekanligini tekshiring."
                android:textColor="#94a3b8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnChangeServerError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#6366f1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Server manzilini sozlash"
                android:textAllCaps="false"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#1e293b"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Qayta urinish"
                android:textAllCaps="false"
                android:textColor="#e2e8f0" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
